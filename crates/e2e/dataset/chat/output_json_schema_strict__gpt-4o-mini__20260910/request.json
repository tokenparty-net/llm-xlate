{
  "method": "POST",
  "url": "https://api.openai.com/v1/chat/completions",
  "stream": true,
  "headers": {
    "authorization": "<redacted>",
    "content-type": "application/json"
  },
  "body": {
    "max_completion_tokens": 128,
    "messages": [
      {
        "content": "Give the city Paris and a rough population.",
        "role": "user"
      }
    ],
    "model": "gpt-4o-mini",
    "response_format": {
      "json_schema": {
        "name": "city_pop",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "city": {
              "type": "string"
            },
            "population": {
              "type": "integer"
            }
          },
          "required": [
            "city",
            "population"
          ],
          "type": "object"
        },
        "strict": true
      },
      "type": "json_schema"
    },
    "stream": true
  }
}
