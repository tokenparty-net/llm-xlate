{
  "method": "POST",
  "url": "https://api.openai.com/v1/responses",
  "stream": false,
  "headers": {
    "authorization": "<redacted>",
    "content-type": "application/json"
  },
  "body": {
    "input": "Give a 3-letter code.",
    "max_output_tokens": 128,
    "model": "gpt-4o-mini",
    "text": {
      "format": {
        "name": "code",
        "schema": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "minLength": 2,
              "pattern": "^[A-Z]+$",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        "strict": true,
        "type": "json_schema"
      }
    }
  }
}
