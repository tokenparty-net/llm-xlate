{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "stream": true,
  "headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json",
    "x-api-key": "<redacted>"
  },
  "body": {
    "max_tokens": 128,
    "messages": [
      {
        "content": "Write the word START then the word END and nothing after.",
        "role": "user"
      }
    ],
    "model": "claude-sonnet-5",
    "stop_sequences": [
      "END"
    ],
    "stream": true
  }
}
