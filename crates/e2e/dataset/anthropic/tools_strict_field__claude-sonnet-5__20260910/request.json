{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "stream": false,
  "headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json",
    "x-api-key": "<redacted>"
  },
  "body": {
    "max_tokens": 128,
    "messages": [
      {
        "content": "Weather in Paris? Use the tool.",
        "role": "user"
      }
    ],
    "model": "claude-sonnet-5",
    "tools": [
      {
        "description": "Get weather.",
        "input_schema": {
          "additionalProperties": false,
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ],
          "type": "object"
        },
        "name": "get_weather",
        "strict": true
      }
    ]
  }
}
