{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "stream": false,
  "headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json",
    "x-api-key": "<redacted>"
  },
  "body": {
    "max_tokens": 128,
    "messages": [
      {
        "content": "Give a timestamp and an email.",
        "role": "user"
      }
    ],
    "model": "claude-sonnet-5",
    "output_config": {
      "format": {
        "schema": {
          "additionalProperties": false,
          "properties": {
            "when": {
              "format": "date-time",
              "type": "string"
            },
            "who": {
              "format": "email",
              "type": "string"
            }
          },
          "required": [
            "when",
            "who"
          ],
          "type": "object"
        },
        "type": "json_schema"
      }
    }
  }
}
