{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "stream": true,
  "headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json",
    "x-api-key": "<redacted>"
  },
  "body": {
    "max_tokens": 256,
    "messages": [
      {
        "content": "What is 17*23? Think step by step, then give the number.",
