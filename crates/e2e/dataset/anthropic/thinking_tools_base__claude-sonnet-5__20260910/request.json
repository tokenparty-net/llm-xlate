{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "stream": true,
  "headers": {
    "anthropic-version": "2023-06-01",
    "content-type": "application/json",
    "x-api-key": "<redacted>"
  },
  "body": {
    "max_tokens": 256,
    "messages": [
      {
        "content": "Use the tool to get the weather in Paris.",
        "role": "user"
      }
    ],
    "model": "claude-sonnet-5",
    "output_config": {
      "effort": "medium"
    },
    "thinking": {
      "type": "adaptive"
    },
    "tool_choice": {
      "type": "any"
    },
    "tools": [
      {
        "description": "Get the current weather for a city.",
        "input_schema": {
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ],
          "type": "object"
        },
        "name": "get_weather"
      }
    ],
    "stream": true
  }
}
