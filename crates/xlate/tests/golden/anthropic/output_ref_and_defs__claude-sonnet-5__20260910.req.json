            "required": [
              "city"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "home": {
            "$ref": "#/$defs/addr"
          }
        },
        "required": [
          "home"
        ],
        "type": "object"
      },
      "type": "json_schema"
    }
  }
}
